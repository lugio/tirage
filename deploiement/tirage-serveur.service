# Service du serveur tirage. À placer dans /etc/systemd/system/.
[Unit]
Description=Tirage : serveur du suivi des impressions
After=network.target

[Service]
ExecStart=/usr/local/bin/tirage-serveur --config /etc/tirage/serveur.toml
# Le serveur s'arrête proprement sur SIGINT : les requêtes en cours se terminent.
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
User=tirage
Group=tirage
StateDirectory=tirage
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
